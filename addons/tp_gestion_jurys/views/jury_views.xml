<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Action -->
    <record id="action_tp_jury" model="ir.actions.act_window">
        <field name="name">Jurys TP</field>
        <field name="res_model">tp.jury</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu principal -->
    <menuitem id="menu_tp_root" name="Jurys TP" sequence="10"/>

    <!-- Sous-menu -->
    <menuitem id="menu_tp_jurys"
              name="Gestion des Jurys"
              parent="menu_tp_root"
              action="action_tp_jury"
              sequence="10"/>

    <!-- Vue liste -->
    <record id="view_tp_jury_tree" model="ir.ui.view">
        <field name="name">tp.jury.tree</field>
        <field name="model">tp.jury</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="responsable"/>
                <field name="date_jury"/>
                <field name="decision"/>
            </tree>
        </field>
    </record>

    <!-- Vue formulaire -->
    <record id="view_tp_jury_form" model="ir.ui.view">
        <field name="name">tp.jury.form</field>
        <field name="model">tp.jury</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="responsable"/>
                        <field name="date_jury"/>
                        <field name="decision"/>
                    </group>
                    <group>
                        <field name="commentaire"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
